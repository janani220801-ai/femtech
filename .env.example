# FemTech - Server Configuration
PORT=5000
NODE_ENV=development

# MongoDB Connection String (Local MongoDB or MongoDB Atlas)
# If local MongoDB is not running, FemTech will automatically fallback gracefully to in-memory mode
MONGO_URI=mongodb://localhost:27017/femtech

# JWT Secret for Session & Route Security
JWT_SECRET=femtech_super_secret_jwt_key_2025_epics

# Frontend Client URL for CORS
CLIENT_URL=http://localhost:5173

# Optional: External AI API Key (Gemini or OpenAI). FemTech comes with a built-in Multilingual Demo AI Engine
AI_API_KEY=your_google_api_key_here

# Optional: Google Maps API Key for Nearby Hospitals & Pharmacies. FemTech includes rich fallback care locations
MAPS_API_KEY=
